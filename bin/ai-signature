#!/usr/bin/env python3
"""The Co-Authored-By trailer an AI agent signs its commits with, measured, not guessed.

    Co-Authored-By: Claude Opus 5.5 (effort: high, context: 230k/1M)

An agent asked to sign with its own model, effort and context fill gets two of the
three wrong: it does not know its effort level (sessions running on high signed
"effort: low") and it cannot see how full its window is. The status line can — the
harness hands it exactly those fields on every render — so each status line pipes
its payload in here, and the agent reads back the finished line at commit time.

    ai-signature --record claude            # Claude Code status line: payload on stdin
    ai-signature --record copilot <PID>     # Copilot CLI status line: payload on stdin, PID = $PPID
    ai-signature                            # in the agent's shell: print the trailer

The reader finds its own session by $CLAUDE_CODE_SESSION_ID (Claude Code exports
it to every shell command) or else by walking up its process ancestry to the
Copilot CLI process that also launched the status line. Exits 1 with nothing on
stdout when no record matches, so a caller can fall back to writing it by hand.
"""
import json, os, re, subprocess, sys, time

STORE = os.path.expanduser("~/.ai-signature")


def human(n):
    n = float(n)
    if n >= 1_000_000:
        return f"{n / 1_000_000:g}M" if n % 100_000 == 0 else f"{n / 1_000_000:.1f}M"
    return f"{round(n / 1000)}k"


def find(obj, *names):
    """First scalar value for any of `names`, searched recursively (Copilot's
    payload nests and renames its fields between releases)."""
    for name in names:
        stack = [obj]
        while stack:
            cur = stack.pop()
            if isinstance(cur, dict):
                if name in cur and not isinstance(cur[name], (dict, list)):
                    return cur[name]
                stack.extend(cur.values())
            elif isinstance(cur, list):
                stack.extend(cur)
    return None


def pretty_model(raw):
    """claude-sonnet-5 -> Claude Sonnet 5, gpt-5.5 -> GPT-5.5, Opus 5.5 -> Claude Opus 5.5."""
    raw = re.sub(r"\s*\([^)]*\)", "", raw).strip()           # "Opus 5.5 (1M context)"
    low = raw.lower()
    if low.startswith("claude-"):
        return "Claude " + " ".join(w.capitalize() for w in raw[7:].split("-"))
    if low.startswith("gpt-"):
        return "GPT-" + raw[4:]
    if re.match(r"(opus|sonnet|haiku|fable)\b", low):
        return "Claude " + raw
    return raw


def trailer(model, effort, used, size):
    details = []
    if effort:
        details.append(f"effort: {effort}")
    if used is not None and size:
        details.append(f"context: {human(used)}/{human(size)}")
    elif size:
        details.append(f"context: {human(size)}")
    tail = f" ({', '.join(details)})" if details else ""
    return f"Co-Authored-By: {model}{tail}"


def from_claude(d):
    model = pretty_model((d.get("model") or {}).get("display_name") or "Claude")
    effort = (d.get("effort") or {}).get("level")
    cw = d.get("context_window") or {}
    size = cw.get("context_window_size")
    cu = cw.get("current_usage") or {}
    used = None
    if cu:
        used = sum(cu.get(k) or 0 for k in
                   ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
    elif cw.get("used_percentage") is not None and size:
        used = float(cw["used_percentage"]) * float(size) / 100
    return d.get("session_id"), trailer(model, effort, used, size)


def from_copilot(d):
    # display_name looks like "claude-sonnet-5 · medium · 264K context"
    name = find(d, "display_name", "displayName") or find(d, "id", "model") or "Copilot"
    bits = [b.strip() for b in str(name).split(" · ") if "context" not in b.lower()]
    model = pretty_model(bits[0] if bits else "Copilot")
    effort = bits[1] if len(bits) > 1 and bits[1] else None
    used = find(d, "current_context_tokens", "currentContextTokens")
    size = find(d, "displayed_context_limit", "displayedContextLimit",
                "context_window_size", "contextWindowSize")
    return trailer(model, effort, used, size)


def record(kind, pid):
    try:
        d = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return
    if kind == "claude":
        sid, line = from_claude(d)
        if not sid:
            return
        key = f"claude-{sid}"
    else:
        key, line = f"copilot-{pid}", from_copilot(d)
    os.makedirs(STORE, exist_ok=True)
    path = os.path.join(STORE, key)
    try:
        with open(path) as f:
            if f.read() == line:
                os.utime(path)
                return
    except OSError:
        pass
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(line)
    os.replace(tmp, path)
    prune()


def prune(max_age=7 * 86400):
    cutoff = time.time() - max_age
    for n in os.listdir(STORE):
        p = os.path.join(STORE, n)
        try:
            if os.path.getmtime(p) < cutoff:
                os.unlink(p)
        except OSError:
            pass


def ancestors():
    pid = os.getppid()
    while pid > 1:
        yield pid
        try:
            out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                                 capture_output=True, text=True).stdout.strip()
            pid = int(out)
        except ValueError:
            return


def read():
    keys = []
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if sid:
        keys.append(f"claude-{sid}")
    keys += [f"copilot-{p}" for p in ancestors()]
    for key in keys:
        try:
            with open(os.path.join(STORE, key)) as f:
                print(f.read())
                return 0
        except OSError:
            continue
    return 1


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["--record"]:
        try:
            record(a[1], a[2] if len(a) > 2 else os.getppid())
        except Exception:
            pass                       # never break a status line render
        sys.exit(0)
    sys.exit(read())
