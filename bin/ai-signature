#!/usr/bin/env python3
"""Print the Co-Authored-By trailer this AI session signs its commits with — measured, not guessed.

    Co-Authored-By: Claude Opus 5.5 (effort: high, context: 230k/1M)

An agent asked to sign with its own model, effort and context fill guesses (a
session running on high signed "effort: low") and cannot see how full its window
is. Its harness writes all three down, per model call, in its own session log —
so the agent runs this right before committing and pastes the line verbatim.

Claude Code: $CLAUDE_CODE_SESSION_ID names the transcript
  ~/.claude/projects/*/<id>.jsonl; the last main-thread assistant entry carries the
  model, its "effort", and the usage whose input + cache read + cache write is the
  prompt size of that call, i.e. how full the window was.

Copilot (CLI and VS Code, same runtime and log): no session id reaches the shell,
  so the session is the one whose ~/.copilot/session-state/*/events.jsonl holds a
  still-unfinished tool call running this very script. Its last main-agent
  session.usage_record gives model, prompt size and max prompt; the effort is that
  record's own reasoningEffort (VS Code), else the reasoning_effort of the last
  main-conversation call (CLI), else the last model change or the session start.

Exits 1, printing nothing, when the session cannot be found.
"""
import glob, json, os, re, sys, time


def human(n):
    n = float(n)
    if n >= 1_000_000:
        return f"{n / 1_000_000:g}M" if n % 100_000 == 0 else f"{n / 1_000_000:.1f}M"
    return f"{round(n / 1000)}k"


def pretty_model(raw):
    """claude-opus-5-5 -> Claude Opus 5.5, claude-sonnet-5 -> Claude Sonnet 5, gpt-5.5 -> GPT-5.5"""
    raw = re.sub(r"\[.*?\]|\s*\(.*?\)", "", raw).strip()
    low = raw.lower()
    if low.startswith("claude-"):
        words = raw[7:].split("-")
        name = [w.capitalize() for w in words if not w.isdigit()]
        version = ".".join(w for w in words if w.isdigit())
        return " ".join(["Claude", *name] + ([version] if version else []))
    if low.startswith("gpt-"):
        return "GPT-" + raw[4:]
    return raw


def trailer(model, effort, used, size):
    details = []
    if effort:
        details.append(f"effort: {effort}")
    if used is not None and size:
        details.append(f"context: {human(used)}/{human(size)}")
    tail = f" ({', '.join(details)})" if details else ""
    return f"Co-Authored-By: {model}{tail}"


def lines(path):
    with open(path, errors="replace") as f:
        for line in f:
            yield line


# --- Claude Code --------------------------------------------------------------
def claude(sid):
    paths = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl"))
    if not paths:
        return None
    last = None
    for line in lines(paths[0]):
        if '"assistant"' not in line or '"usage"' not in line:
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "assistant" and not e.get("isSidechain") and (e.get("message") or {}).get("usage"):
            last = e
    if not last:
        return None
    msg = last["message"]
    model_id = msg.get("model") or ""
    u = msg["usage"]
    used = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    effort = last.get("effort") or os.environ.get("CLAUDE_EFFORT")
    # The transcript records no window size. Opus and Fable only run at 1M here;
    # anything else does only with the explicit [1m] suffix.
    big = "[1m]" in model_id or re.search(r"opus|fable", model_id) or used > 200_000
    return trailer(pretty_model(model_id), effort, used, 1_000_000 if big else 200_000)


# --- Copilot ------------------------------------------------------------------
def copilot_session(max_age=3600):
    """events.jsonl of the session that is running this script right now."""
    best, best_ts = None, ""
    cutoff = time.time() - max_age
    for path in glob.glob(os.path.expanduser("~/.copilot/session-state/*/events.jsonl")):
        try:
            if os.path.getmtime(path) < cutoff:
                continue
        except OSError:
            continue
        open_calls = {}
        for line in lines(path):
            if "tool.execution_" not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            d = e.get("data") or {}
            if e.get("type") == "tool.execution_start" and "ai-signature" in json.dumps(d.get("arguments")):
                open_calls[d.get("toolCallId")] = e.get("timestamp") or ""
            elif e.get("type") == "tool.execution_complete":
                open_calls.pop(d.get("toolCallId"), None)
        for ts in open_calls.values():
            if ts >= best_ts:
                best, best_ts = path, ts
    return best


def copilot(path):
    usage, effort, fallback_effort, fallback_model = None, None, None, None
    for line in lines(path):
        if not any(k in line for k in ("usage_record", "usage_checkpoint", "model_change", "session.start")):
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue
        t, d = e.get("type"), e.get("data") or {}
        if t == "session.usage_record":
            u = d.get("usage") or {}
            if u.get("interactionType") == "conversation-agent":
                usage = u
        elif t == "session.usage_checkpoint":
            for conv in d.get("promptCacheBreakState") or []:
                if conv.get("conversation") == "main":
                    for m in (conv.get("models") or {}).values():
                        if m.get("reasoning_effort"):
                            effort = m["reasoning_effort"]
        elif t in ("session.start", "session.model_change"):
            fallback_effort = d.get("reasoningEffort") or fallback_effort
            fallback_model = d.get("newModel") or d.get("selectedModel") or fallback_model
    if not usage:   # older CLIs (≤1.0.9x) log no usage records: model and effort only
        if fallback_model and fallback_model != "auto":
            return trailer(pretty_model(fallback_model), effort or fallback_effort, None, None)
        return None
    # VS Code's runtime stamps the effort on the usage record itself; the CLI does not.
    effort = usage.get("reasoningEffort") or effort
    model = usage.get("modelDisplayName") or pretty_model(usage.get("model") or "Copilot")
    return trailer(model, effort or fallback_effort, usage.get("inputTokens"), usage.get("maxPromptTokens"))


def main():
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    line = claude(sid) if sid else None
    if not line:
        path = copilot_session()
        line = copilot(path) if path else None
    if not line:
        return 1
    print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
